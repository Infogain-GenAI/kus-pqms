#!/bin/sh
# Router: enforce each component's own commit-message convention.
# Teams do not edit this file. Teams edit <folder>/commit-msg.rules
# (or add <folder>/commitlint.config.js, which takes precedence).
MSG_FILE=$1
CHANGED=$(git diff --cached --name-only | cut -d/ -f1 | sort -u)
HEADER=$(head -n1 "$MSG_FILE")

# Let Git's own generated commits through untouched.
case "$HEADER" in
  Merge*|Revert*|fixup!*|squash!*) exit 0 ;;
esac

COUNT=$(echo "$CHANGED" | wc -w | tr -d ' ')
if [ "$COUNT" -gt 1 ]; then
  echo "!  This commit touches multiple components: $CHANGED"
  echo "   Prefer splitting it. Cross-cutting commits use: chore(repo): <subject>"
fi

STATUS=0
for c in $CHANGED; do
  if [ -f "$c/commitlint.config.js" ]; then
    # Node components: run from inside the folder so commitlint picks up that
    # folder's config. MSG_FILE is repo-relative, so step back out.
    ( cd "$c" && npx --no-install commitlint --edit "../$MSG_FILE" ) || STATUS=1
  elif [ -f "$c/commit-msg.rules" ]; then
    # Line 1 is the pattern; subsequent '# ' lines are the help text.
    PATTERN=$(head -n1 "$c/commit-msg.rules")
    # NOTE: pipe the header into grep. Passing it as an argument would make
    # grep treat the commit message text as a filename.
    if ! printf '%s\n' "$HEADER" | grep -qE "$PATTERN"; then
      echo "x  $c: invalid commit message"
      echo "   got: $HEADER"
      sed -n '2,$p' "$c/commit-msg.rules" | sed 's/^# /   /'
      STATUS=1
    fi
  fi
done
exit $STATUS
