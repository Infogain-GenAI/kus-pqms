{
  "name": "kus-pqms-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@11.1.3",
  "engines": {
    "node": "^20.9.0 || >=21.1.0"
  },
  "description": "N-PQMS Issue & Signal Management (ISM) — React UI. Mirrors the current UX design 1:1 (no new features). Design system vendored from _bmad-output/planning-artifacts/ux/design-source/design-system.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && pnpm run lint:adherence && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint:adherence": "eslint --config eslint.adherence.config.mjs --max-warnings 662 src",
    "tokens:gen": "node scripts/gen-tokens.mjs",
    "tokens:check": "node scripts/check-tokens.mjs",
    "docs:standards": "node scripts/build-standards-doc.mjs",
    "docs:standards:check": "node scripts/build-standards-doc.mjs --check"
  },
  "dependencies": {
    "lucide-react": "^0.451.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/parser": "^8.67.0",
    "@vitejs/plugin-react": "^4.3.3",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "playwright": "^1.62.1",
    "prettier": "^3.9.6",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
