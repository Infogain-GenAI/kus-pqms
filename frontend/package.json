{
  "name": "kus-pqms-frontend-workspace",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "description": "N-PQMS Issue & Signal Management (ISM) — React UI. Mirrors the current UX design 1:1 (no new features). Design system vendored from _bmad-output/planning-artifacts/ux/design-source/design-system.",
  "scripts": {
    "prepare": "node scripts/setup-hooks.mjs",
    "dev": "pnpm --filter @pqms/portal dev",
    "build": "pnpm run typecheck && pnpm run tokens:check && pnpm run tokens:drift && pnpm run lint:css-vars && pnpm run lint:ds && pnpm --filter @pqms/portal build",
    "preview": "pnpm --filter @pqms/portal preview",
    "typecheck": "pnpm -r --parallel exec tsc --noEmit",
    "lint:ds:values": "node scripts/ds-gate.mjs values",
    "lint:ds:numeric": "node scripts/ds-gate.mjs numeric",
    "lint:ds:imports": "node scripts/ds-gate.mjs imports",
    "lint:ds:copy": "node scripts/ds-gate.mjs copy",
    "lint:ds": "pnpm run lint:ds:values && pnpm run lint:ds:numeric && pnpm run lint:ds:imports && pnpm run lint:ds:copy",
    "lint:ds:selftest": "node scripts/check-import-rule.mjs",
    "lint:css-vars": "node scripts/check-css-vars.mjs",
    "lint:roles": "node scripts/check-role-gate.mjs",
    "lint:i18n": "node scripts/check-i18n-namespaces.mjs",
    "tokens:gen": "pnpm --filter @pqms/design-tokens tokens:gen",
    "tokens:check": "pnpm --filter @pqms/design-tokens tokens:check",
    "tokens:drift": "node scripts/check-tokens-drift.mjs",
    "hooks:check": "node scripts/setup-hooks.mjs --check",
    "fidelity:baseline": "node scripts/fidelity-gate.mjs --write",
    "fidelity:check": "node scripts/fidelity-gate.mjs --check",
    "style:diff": "node scripts/style-gate.mjs --check",
    "style:diff:baseline": "node scripts/style-gate.mjs --write",
    "tokens:equiv": "node scripts/check-token-equivalence.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "coverage:gate": "vitest run --coverage && node scripts/coverage-gate.mjs",
    "coverage:seed": "vitest run --coverage && node scripts/coverage-gate.mjs --seed"
  },
  "devDependencies": {
    "@tanstack/react-query": "^5.102.8",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@typescript-eslint/parser": "^8.67.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^4.1.11",
    "axe-core": "^4.13.0",
    "axios": "^1.20.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "i18next": "^26.4.0",
    "jsdom": "^30.0.1",
    "lucide-react": "0.469.0",
    "pixelmatch": "^7.2.0",
    "playwright": "1.62.1",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-i18next": "^17.0.12",
    "typescript": "^5.6.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "vitest-axe": "^0.1.0",
    "zod": "^4.5.4",
    "zustand": "^5.0.15",
    "react-router": "^8.3.1"
  }
}
