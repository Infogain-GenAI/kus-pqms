# Repo-wide only. Anything stack-specific belongs in that component's
# own .gitignore -- Git reads a .gitignore in every directory natively.

# Editors / IDEs
.idea/
.vscode/
*.swp
*~

# OS
.DS_Store
Thumbs.db
desktop.ini

# Secrets -- never commit these from anywhere in the tree
.env
.env.local
!.env.example

# Logs
*.log

# Generated by frontend/scripts/dc-compare.mjs beside its runtime assets in the
# tracked UX design-source export. It must live there to resolve support.js/_ds by
# relative path, so it is ignored rather than relocated.
_boot-admin.dc.html

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files #
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*
replay_pid*
.bmad-loop/runs/
.bmad-loop/cache/
.bmad-loop/policy.toml
_bmad/render/

# Node / JS / React (frontend/)
node_modules/
frontend/node_modules/
dist/
frontend/dist/
.vite/
*.tsbuildinfo
storybook-static/
playwright-report/
test-results/
frontend/.fidelity/
