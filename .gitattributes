# Normalise text files on commit.
* text=auto

# Hooks and shell scripts MUST stay LF. A CRLF hook fails on Windows with
# "bad interpreter: /bin/sh^M: no such file or directory".
.githooks/*  text eol=lf
*.sh         text eol=lf

# Windows batch files must stay CRLF.
*.bat        text eol=crlf
*.cmd        text eol=crlf

# Binaries
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.jar binary
*.zip binary
*.pdf binary
